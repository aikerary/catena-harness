{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "model": "bedrock-opencode/gpt-6-1-terra#medium",
  "update": "notify",
  "providers": {
    "bedrock-opencode": {
      "package": "@opencode/ai/providers/amazon-bedrock",
      "settings": {
        "profile": "aiker-bot",
        "region": "us-east-1"
      },
      "models": {
        "claude-haiku-5-5": {
          "modelID": "global.anthropic.claude-haiku-5-5",
          "name": "Claude Haiku 5.5",
          "limit": { "context": 122000, "input": 90000, "output": 32000 }
        },
        "gpt-6-luna": {
          "modelID": "global.openai.gpt-6-luna",
          "name": "GPT-6 Luna",
          "limit": { "context": 282000, "input": 250000, "output": 32000 },
          "capabilities": { "reasoning": { "supported": true, "effort": ["low", "medium", "high"] } },
          "variants": [
            { "id": "max", "body": { "additionalModelRequestFields": { "reasoning": { "effort": "max" } } } }
          ]
        },
        "gpt-6-1-terra": {
          "modelID": "global.openai.gpt-6.1-terra",
          "name": "GPT-6.1 Terra",
          "limit": { "context": 282000, "input": 250000, "output": 32000 },
          "capabilities": { "reasoning": { "supported": true, "effort": ["low", "medium", "high"] } },
          "variants": [
            { "id": "max", "body": { "additionalModelRequestFields": { "reasoning": { "effort": "max" } } } }
          ]
        }
      }
    }
  },
  "policies": [
    { "action": "provider.use", "resource": "amazon-bedrock", "effect": "deny" }
  ],
  "permissions": [
    { "action": "subagent", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "plan": {
      "model": "bedrock-opencode/gpt-6-1-terra#high",
      "permissions": [
        { "action": "subagent", "resource": "triage", "effect": "allow" },
        { "action": "subagent", "resource": "debugger", "effect": "allow" },
        { "action": "subagent", "resource": "web-searcher", "effect": "allow" },
        { "action": "shell", "resource": "opencode run *", "effect": "deny" },
        { "action": "shell", "resource": "*/opencode run *", "effect": "deny" }
      ]
    },
    "build": {
      "model": "bedrock-opencode/gpt-6-1-terra#medium",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "triage", "effect": "allow" },
        { "action": "subagent", "resource": "debugger", "effect": "allow" },
        { "action": "subagent", "resource": "web-searcher", "effect": "allow" },
        { "action": "subagent", "resource": "coder-weak", "effect": "allow" },
        { "action": "subagent", "resource": "coder-strong", "effect": "allow" },
        { "action": "subagent", "resource": "ui-designer", "effect": "allow" },
        { "action": "subagent", "resource": "tester-weak", "effect": "allow" },
        { "action": "subagent", "resource": "tester-strong", "effect": "allow" },
        { "action": "subagent", "resource": "linter", "effect": "allow" },
        { "action": "subagent", "resource": "security-auditor", "effect": "allow" },
        { "action": "subagent", "resource": "documenter", "effect": "allow" },
        { "action": "subagent", "resource": "readmer", "effect": "allow" },
        { "action": "subagent", "resource": "contributer", "effect": "allow" },
        { "action": "subagent", "resource": "licenser", "effect": "allow" },
        { "action": "subagent", "resource": "analyzer-weak", "effect": "allow" },
        { "action": "subagent", "resource": "analyzer-strong", "effect": "allow" },
        { "action": "subagent", "resource": "devops", "effect": "allow" },
        { "action": "subagent", "resource": "git-manager", "effect": "allow" },
        { "action": "subagent", "resource": "generalist-weak", "effect": "allow" },
        { "action": "subagent", "resource": "generalist-strong", "effect": "allow" }
      ]
    }
  }
}
